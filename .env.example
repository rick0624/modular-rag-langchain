# 複製為 .env 後填入實際值;load_config() 會自動載入(已存在的環境變數優先)。
# configs/online.yaml 透過 ${VAR} 引用這些變數。

# --- generation: openai_compatible(OpenAI / vLLM / Ollama / 公司閘道)---
OPENAI_API_KEY=YOUR_TOKEN
OPENAI_BASE_URL=https://api.openai.com/v1

# --- embedding: api / reranking: api(公司 HTTP API)---
EMBEDDING_API_URL=https://llm.example.com/v1/embeddings
RERANK_API_URL=https://rerank.example.com/v1/rerank
API_TOKEN=YOUR_TOKEN

# --- indexing: elasticsearch ---
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=YOUR_PASSWORD
